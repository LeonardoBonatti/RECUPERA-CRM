# Copie para .env (o .env NÃO vai para o git). Na Vercel, configure em Settings → Environment Variables.

# String de conexão do Neon (Dashboard Neon → Connect → "Pooled connection").
# Na Vercel, a integração Neon cria DATABASE_URL automaticamente.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Opcional: acessos criados automaticamente se ainda não existirem (JSON em uma linha).
# Depois de criados, são gerenciados pela tela "Equipe e acessos".
BOOTSTRAP_USERS=[{"name":"Gerente Exemplo","email":"gerente@exemplo.com","role":"NACIONAL"},{"name":"Regional Exemplo","email":"regional@exemplo.com","role":"REGIONAL","regions":["Sudeste"]},{"name":"Executivo Exemplo","email":"executivo@exemplo.com","role":"EXECUTIVO","region":"Sudeste","aliases":["EXECUTIVO EX."]}]

# Opcional: senha inicial dos acessos acima (troca obrigatória no 1º login).
# Se vazio, cada acesso recebe uma senha aleatória e o Gerente Nacional entrega pela tela ("Gerar acesso").
ADMIN_PASSWORD=

# Opcional: um Gerente Nacional extra.
ADMIN_EMAIL=

# Regionais criadas no primeiro acesso.
SEED_REGIONS=Centro-Oeste,Leste,Nordeste,Norte,Sudeste
